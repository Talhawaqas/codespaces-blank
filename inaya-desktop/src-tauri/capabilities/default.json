{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://www.inayanetwork.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "dialog:default",
    "allow-notify-pending-approvals",
    "allow-notify-security-event",
    "allow-notify-chat-message",
    "allow-set-chat-unread",
    "allow-block-ip",
    "allow-unblock-ip",
    "allow-store-passkey-secure",
    "allow-retrieve-passkey-secure",
    "allow-clear-passkey-secure",
    "allow-open-module-window",
    "allow-mount-inaya-drive",
    "allow-unmount-inaya-drive",
    "allow-directsync-store-credential",
    "allow-directsync-credential-configured",
    "allow-directsync-clear-credential",
    "allow-directsync-pick-folder",
    "allow-directsync-add-folder",
    "allow-directsync-remove-folder",
    "allow-directsync-pause-folder",
    "allow-directsync-resume-folder",
    "allow-directsync-list-folders",
    "allow-directsync-list-queue",
    "allow-directsync-retry-failed",
    "allow-directsync-create-secure-link",
    "allow-cleaner-scan",
    "allow-cleaner-cleanup"
  ]
}
