{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inaya Business Workspace",
  "version": "0.1.0",
  "identifier": "com.inayanetwork.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inaya Business Workspace",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "https://www.inayanetwork.com/business"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
