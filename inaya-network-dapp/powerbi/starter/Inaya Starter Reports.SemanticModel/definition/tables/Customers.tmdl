table Customers

	/// Customer ID
	column id
		dataType: string
		summarizeBy: none
		sourceColumn: id

	/// Name
	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name

	/// Company
	column company
		dataType: string
		summarizeBy: none
		sourceColumn: company

	/// Type (customer, lead...)
	column type
		dataType: string
		summarizeBy: none
		sourceColumn: type

	/// Email
	column email
		dataType: string
		summarizeBy: none
		sourceColumn: email

	/// Phone
	column phone
		dataType: string
		summarizeBy: none
		sourceColumn: phone

	/// Created
	column createdAt
		dataType: dateTime
		summarizeBy: none
		sourceColumn: createdAt

	/// Deleted in Inaya
	column isDeleted
		dataType: boolean
		summarizeBy: none
		sourceColumn: isDeleted

	partition Customers = m
		mode: import
		source =
				let
				    Source = Inaya.Dataset("customers", RangeStart, RangeEnd)
				in
				    Source
