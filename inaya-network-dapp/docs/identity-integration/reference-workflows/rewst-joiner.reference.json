{
  "_note": "REFERENCE ONLY. This describes the calls a Rewst workflow makes; it is NOT a Rewst export and has never been imported into a real Rewst workspace (status: UNVERIFIED).",
  "name": "Inaya joiner (onboarding)",
  "trigger": { "type": "webhook-or-ticket", "description": "HR hire or PSA onboarding ticket" },
  "variables": {
    "INAYA_BASE_URL": "https://<your-inaya-host>",
    "INAYA_CREDENTIAL": "<idc_... service credential with identity:provision (store in a Rewst secret)>",
    "INAYA_PROVIDER_ID": "<the Inaya identity provider id for this tenant>",
    "INAYA_ORGANIZATION_ID": "<customer organization id (MSP credentials only)>"
  },
  "steps": [
    { "id": "create_directory_account", "description": "Create the AD / Entra account and add the department groups (your side).", "type": "your-directory-step" },
    {
      "id": "inaya_dry_run",
      "type": "http",
      "description": "Preview first. The response text ends with LIVE MUTATION: NO.",
      "request": {
        "method": "POST",
        "url": "{{INAYA_BASE_URL}}/api/integrations/identity/dry-run",
        "headers": { "Authorization": "Bearer {{INAYA_CREDENTIAL}}", "X-Inaya-Organization": "{{INAYA_ORGANIZATION_ID}}", "Content-Type": "application/json" },
        "body": { "providerId": "{{INAYA_PROVIDER_ID}}", "event": { "type": "user.created", "subject": { "externalId": "{{directory.objectGUID}}", "upn": "{{directory.upn}}", "email": "{{directory.mail}}", "department": "{{directory.department}}", "groups": "{{directory.groups}}", "accountEnabled": true } } }
      }
    },
    {
      "id": "inaya_provision",
      "type": "http",
      "request": {
        "method": "POST",
        "url": "{{INAYA_BASE_URL}}/api/integrations/identity/users/provision",
        "headers": { "Authorization": "Bearer {{INAYA_CREDENTIAL}}", "X-Inaya-Organization": "{{INAYA_ORGANIZATION_ID}}", "Idempotency-Key": "onboard-{{ticket.id}}", "Content-Type": "application/json" },
        "body": { "providerId": "{{INAYA_PROVIDER_ID}}", "event": { "eventId": "onboard-{{ticket.id}}", "type": "user.created", "occurredAt": "{{now_iso}}", "subject": { "externalId": "{{directory.objectGUID}}", "upn": "{{directory.upn}}", "email": "{{directory.mail}}", "department": "{{directory.department}}", "groups": "{{directory.groups}}", "accountEnabled": true } } }
      },
      "expect": { "status": 200, "path": "status", "values": ["PROCESSED", "DUPLICATE"] }
    },
    { "id": "note", "description": "Access comes from Inaya group and attribute mappings, not from this workflow. Privileged grants wait for a human approval (status AWAITING_APPROVAL).", "type": "ticket-note" }
  ]
}
